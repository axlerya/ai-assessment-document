# Настройки document-worker. Секции разделяются двойным подчёркиванием.
# Незакомментированные переменные обязательны, остальные показаны со значением
# по умолчанию. Лишняя переменная с префиксом секции отвергается на старте:
# опечатка иначе тихо превращается в значение по умолчанию.

# --- PostgreSQL -------------------------------------------------------------
DATABASE__DSN=postgresql+asyncpg://document_worker:change-me@postgres:5432/documents
# Соединений в пуле не меньше, чем документов в работе, иначе каждая страница
# ждёт освобождения соединения.
#DATABASE__POOL_SIZE=10
#DATABASE__MAX_OVERFLOW=0
#DATABASE__POOL_TIMEOUT_S=10.0
#DATABASE__CLAIM_TIMEOUT_MS=5000
#DATABASE__RELEASE_TIMEOUT_MS=3000
#DATABASE__PAGE_TIMEOUT_MS=5000
#DATABASE__CHUNKS_TIMEOUT_MS=15000
#DATABASE__TERMINAL_TIMEOUT_MS=10000

# --- RabbitMQ ---------------------------------------------------------------
RABBIT__URL=amqp://document_worker:change-me@rabbitmq:5672/documents
# Отсчитывается с момента доставки, а не с начала обработки, поэтому обязан
# быть строго больше PROCESSING__DOCUMENT_TIMEOUT_S.
#RABBIT__CONSUMER_TIMEOUT_MS=7200000
#RABBIT__GRACEFUL_TIMEOUT_S=30.0
#RABBIT__PUBLISH_TIMEOUT_S=5.0
#RABBIT__DELIVERY_LIMIT=20
# Очередь аудита событий нужна только dev и CI.
#RABBIT__DECLARE_AUDIT_QUEUE=false

# --- Хранилище объектов -----------------------------------------------------
S3__ENDPOINT_URL=http://minio:9000
S3__ACCESS_KEY=change-me
S3__SECRET_KEY=change-me
#S3__REGION=us-east-1
#S3__DEFAULT_BUCKET=documents
#S3__DOWNLOAD_TIMEOUT_S=120.0

# --- Обработка --------------------------------------------------------------
#PROCESSING__DOCUMENT_TIMEOUT_S=3600.0
#PROCESSING__MAX_CONCURRENCY=1
#PROCESSING__MAX_FILE_SIZE_BYTES=104857600
#PROCESSING__MAX_PAGES=300
#PROCESSING__MAX_RENDER_PIXELS=40000000
#PROCESSING__CPU_WORKERS=1
#PROCESSING__TEMP_DIR=/tmp/document-worker
#PROCESSING__TEMP_QUOTA_BYTES=4294967296
# Мажорная часть меняется, когда результат прошлой версии больше не годится.
#PROCESSING__PIPELINE_VERSION=1.0.0

# --- Распознавание ----------------------------------------------------------
# Модели укладываются в образ на сборке; сеть в рантайме запрещена, и при
# отсутствии или подмене файла сервис не стартует.
#OCR__MODEL_DIR=/opt/ocr-models
#OCR__LANGUAGES=["ru","en"]
#OCR__DPI_PRIMARY=300
#OCR__DPI_RETRY=450
#OCR__DPI_DEGRADED=200
#OCR__PAGE_TIMEOUT_S=60.0
#OCR__MAX_PAGE_ATTEMPTS=2
#OCR__RETRY_BELOW_CONFIDENCE=0.6

# --- Чанкование -------------------------------------------------------------
# Бюджет токенов и версия связаны: правка любого числа без инкремента версии
# отвергается на старте, иначе чанки разных границ попадут в один namespace.
#CHUNKING__VERSION=1.0.0
#CHUNKING__ENCODING=o200k_base
#CHUNKING__TARGET_TOKENS=800
#CHUNKING__MAX_TOKENS=1024
#CHUNKING__MIN_TOKENS=200
#CHUNKING__OVERLAP_TOKENS=120

# --- Доставка ---------------------------------------------------------------
# Строго больше PROCESSING__DOCUMENT_TIMEOUT_S: лиз, протухающий в середине
# обработки, делает каждую повторную доставку возобновлением параллельно живому
# воркеру.
#MESSAGING__CLAIM_LEASE_S=5400
#MESSAGING__CONSUMER_NAME=имя хоста

# --- Публикация событий -----------------------------------------------------
#OUTBOX__BATCH_SIZE=100
#OUTBOX__POLL_INTERVAL_S=0.5
#OUTBOX__LEASE_SECONDS=30
#OUTBOX__BACKOFF_BASE_S=1.0
#OUTBOX__BACKOFF_CAP_S=300.0
